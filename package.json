{
  "name": "abstractify",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.e2e.json --pretty false",
    "test:e2e": "playwright test --project=chrome",
    "test:e2e:gate": "playwright test --project=chrome --project=edge",
    "test:e2e:firefox": "playwright test --project=firefox",
    "blockers": "node scripts/release-blockers.mjs",
    "test:artifact": "playwright test --project=artifact",
    "release:artifact": "node scripts/release-artifact.mjs identify dist release/frontend-artifact.json",
    "release:evidence": "node scripts/release-evidence.mjs release-evidence release/playwright-report.json release/playwright-artifact.json",
    "contract:generate": "node scripts/contract.mjs generate",
    "contract:check": "node scripts/contract.mjs check",
    "contract:pair": "node scripts/contract.mjs pair",
    "test:contract": "node --test scripts/contract.test.mjs scripts/renderer-security.test.mjs",
    "test:scripts": "node --test scripts/contract.test.mjs scripts/renderer-security.test.mjs scripts/artifact-identity.test.mjs scripts/release-evidence.test.mjs",
    "verify": "npm run contract:check && npm run test:scripts && npm run lint && npm run typecheck && npm run build",
    "verify:pair": "npm run contract:pair && npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@stomp/stompjs": "^7.1.1",
    "@tailwindcss/vite": "^4.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "lucide-react": "^0.514.0",
    "openapi-fetch": "0.17.0",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.2",
    "react-toastify": "^11.0.5",
    "sockjs-client": "^1.6.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "openapi-typescript": "7.13.0",
    "process": "^0.11.10",
    "tw-animate-css": "^1.3.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.24.0"
  }
}
