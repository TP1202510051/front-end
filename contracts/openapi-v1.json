  "components": {
    "schemas": {
      "ProjectName": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ProjectSummary": {
        "required": [
          "createdAt",
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^[1-9][0-9]*$",
            "type": "string",
            "example": "900001"
          },
          "name": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ProjectPage": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSummary"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Pass as after to read the next page; null means complete",
            "nullable": true
          }
        }
      },
      "ProblemCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "AUTHENTICATION_REQUIRED",
          "RESOURCE_NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "NOT_ACCEPTABLE",
          "CONFLICT",
          "IDEMPOTENCY_KEY_REUSED",
          "UNSUPPORTED_MEDIA_TYPE",
          "SEMANTIC_VALIDATION_FAILED",
          "RATE_LIMITED",
          "DEPENDENCY_UNAVAILABLE",
          "INTERNAL_ERROR"
        ]
      },
      "PublicProblem": {
        "required": [
          "code",
          "correlationId",
          "detail",
          "recoveryAction",
          "status",
          "title",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "recoveryAction": {
            "$ref": "#/components/schemas/RecoveryAction"
          },
          "operationId": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RecoveryAction": {
        "type": "string",
        "enum": [
          "EDIT_REQUEST",
          "SIGN_IN",
          "RETURN_TO_PROJECTS",
          "REFRESH",
          "RETRY_LATER",
          "CONTACT_SUPPORT"
        ]
      },
      "AsyncOperationView": {
        "required": [
          "availableActions",
          "createdAt",
          "operationId",
          "stage",
          "state",
          "updatedAt",
          "version",
          "workType"
        ],
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "workType": {
            "type": "string",
            "enum": [
              "ASSISTANT_PROPOSAL",
              "STORE_EXPORT"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "stage": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "type": "string"
          },
          "progress": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "version": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "resultReference": {
            "$ref": "#/components/schemas/OperationResourceReference"
          },
          "failureCode": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "type": "string",
            "nullable": true
          },
          "availableActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationAction"
            }
          }
        }
      },
      "OperationAction": {
        "type": "string",
        "enum": [
          "REFRESH_STATUS"
        ]
      },
      "OperationResourceReference": {
        "required": [
